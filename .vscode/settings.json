{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  // Do not surface parent Git repositories when opening this folder
  "git.openRepositoryInParentFolders": "never",
  // Re-enable Git integration for this workspace
  "git.enabled": true,
  // Stop auto-detecting repos beyond what you explicitly open
  "git.autoRepositoryDetection": false
}
