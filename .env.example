# Copy this file to .env and fill in your Appwrite project details
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=REPLACE_ME
APPWRITE_API_KEY=REPLACE_ME_ADMIN_API_KEY
APPWRITE_DATABASE_ID=REPLACE_ME_DB_ID
APPWRITE_BUCKET_ID=REPLACE_ME_BUCKET_ID

# Collection IDs used by the init/seed scripts (optional; if omitted, init will use fallback IDs)
APPWRITE_USERS_COLLECTION_ID=REPLACE_ME_USERS_COLLECTION_ID
APPWRITE_COURSES_COLLECTION_ID=REPLACE_ME_COURSES_COLLECTION_ID
APPWRITE_ASSIGNMENTS_COLLECTION_ID=REPLACE_ME_ASSIGNMENTS_COLLECTION_ID
APPWRITE_GROUPS_COLLECTION_ID=REPLACE_ME_GROUPS_COLLECTION_ID
APPWRITE_PROGRESS_NODES_COLLECTION_ID=REPLACE_ME_PROGRESS_NODES_COLLECTION_ID
APPWRITE_MESSAGES_COLLECTION_ID=REPLACE_ME_MESSAGES_COLLECTION_ID

# Optional collections for richer seeding (set if you create them)
APPWRITE_LESSONS_COLLECTION_ID=
APPWRITE_NOTES_COLLECTION_ID=
APPWRITE_RUBRICS_COLLECTION_ID=

# Frontend data source: 'mock' (default) or 'live'
EXPO_PUBLIC_API_MODE=mock

# Per-service override for chat: 'mock' or 'live'.
# When set to 'live', chat uses the live adapter even if EXPO_PUBLIC_API_MODE=mock.
# Omit or set to 'mock' to keep everything in mock.
EXPO_PUBLIC_CHAT_MODE=mock
