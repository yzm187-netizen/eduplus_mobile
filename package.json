{
  "name": "eduplus",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "provision": "node scripts/appwrite/provision.js",
    "seed": "node scripts/seed-appwrite.js",
    "init:assignment": "node -r dotenv/config scripts/appwrite/init-assignment-groups-progress.js",
    "seed:typed": "ts-node scripts/seed-runner.ts",
    "init:schema": "node scripts/init-schema.js",
    "migrate:desc": "node -r dotenv/config scripts/appwrite/expand-course-description.js 2048",
    "grant:course-perms": "node -r dotenv/config scripts/appwrite/grant-course-permissions.js",
    "fix:lessons-title-perms": "node -r dotenv/config scripts/appwrite/backfill-lessons-title-perms.js",
    "check:collections": "node -r dotenv/config scripts/appwrite/check-collection-security.js",
    "inspect:courses": "node -r dotenv/config scripts/appwrite/inspect-courses.js",
    "fix:course-teachers": "node -r dotenv/config scripts/appwrite/fix-course-teachers.js",
    "seed:lessons-assignments": "node -r dotenv/config scripts/appwrite/seed-lessons-assignments.js",
    "fix:course-created-by": "node -r dotenv/config scripts/appwrite/fix-course-created-by.js",
    "shift:demo-dates": "node -r dotenv/config scripts/appwrite/time-shift-demo-dates.js",
    "inspect:profiles": "node -r dotenv/config scripts/appwrite/inspect-profiles.js",
    "fix:profile-name": "node -r dotenv/config scripts/appwrite/fix-profile-name.js",
    "list:lessons": "node -r dotenv/config scripts/appwrite/list-lessons-by-course.js",
    "seed:lessons-with-notes": "node -r dotenv/config scripts/appwrite/seed-lessons-with-notes.js",
    "ensure:lessons-completed": "node -r dotenv/config scripts/appwrite/ensure-lessons-completed-attr.js",
    "ensure:lessons-about": "node -r dotenv/config scripts/appwrite/ensure-lessons-about-attr.js",
    "perms:lessons": "node -r dotenv/config scripts/set-lessons-collection-perms.js",
    "update:desc": "node -r dotenv/config scripts/appwrite/update-course-description.js MATH101",
    "grant:course-team-perms": "node -r dotenv/config scripts/appwrite/grant-course-team-permissions.js",
    "fix:enrollment-user": "node -r dotenv/config scripts/appwrite/fix-enrollment-user-ids.js --email",
    "fix:profile-id": "node -r dotenv/config scripts/appwrite/fix-profile-id.js --email",
    "perms:profiles-read": "node -r dotenv/config scripts/appwrite/backfill-profiles-read-users.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.90.5",
    "deprecated-react-native-prop-types": "^5.0.0",
    "expo": "54.0.21",
    "expo-constants": "~18.0.10",
    "expo-document-picker": "~14.0.7",
    "expo-font": "~14.0.9",
    "expo-image": "~3.0.10",
    "@react-native-community/datetimepicker": "^8.1.1",
    "expo-image-picker": "~15.0.6",
    "expo-linking": "~8.0.8",
    "expo-router": "6.0.14",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.8",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-appwrite": "^0.17.1",
    "react-native-calendars": "^1.1313.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-color-matrix-image-filters": "^7.0.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-pell-rich-editor": "^1.10.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-swipeable": "^0.6.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "node-appwrite": "^20.2.1",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.2.20",
    "postcss": "^8.5.6",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.18",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-calendars": {
      "react-native-safe-area-context": "5.6.1"
    },
    "react-native-appwrite": {
      "expo-file-system": "19.0.17"
    }
  },
  "private": true
}
