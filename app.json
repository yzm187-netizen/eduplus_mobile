{
  "expo": {
    "name": "eduplus",
    "slug": "eduplus",
    "version": "1.0.0",
    "orientation": "portrait",
  "icon": "./assets/images/EduPlus logo_blue.png",
    "scheme": "eduplus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/EduPlus_Banner_v3.png",
      "resizeMode": "contain",
      "backgroundColor": "#2B0D52"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/EduPlus logo_blue.png",
        "backgroundColor": "#2B0D52"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "windowSoftInputMode": "adjustResize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "API_BASE_URL": "http://localhost:3000"
    }
  }
}